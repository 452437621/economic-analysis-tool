# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python/
.tools/
.cache/
.pytest_cache/
.ruff_cache/
pytest-cache-files-*/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime data
data/*
!data/.gitkeep

# Frontend
node_modules/
frontend/dist/
frontend/node_modules/
frontend/.tmp/
.vite/
*.tsbuildinfo
# 前端构建产物：由 scripts/build.ps1 / npm run build 生成，不入版本库
web/

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

# pytest temp dirs
pytest-of-*/
/.idea/

# DSH 工作区目录（技能包、会话与本地运行时状态），由 harness 自行管理，不入库
.dsh/
