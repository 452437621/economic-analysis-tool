# EPIC 环境变量（复制为 .env 后填写；.env 不进版本库）
# 服务
EPIC_HOST=127.0.0.1
EPIC_PORT=8765
EPIC_ENV=local
# 数据库（留空则使用 data/epic.db；示例为相对路径，Windows/Linux 通用）
# EPIC_DATABASE_URL=sqlite:///data/epic.db
# 数据目录（留空则使用项目 data/）
# EPIC_DATA_DIR=

# LLM（DeepSeek，可选；不填则走规则抽取与模板简版）
DEEPSEEK_API_KEY=
EPIC_LLM_MODEL=deepseek-chat
EPIC_LLM_REASONER_MODEL=deepseek-reasoner
EPIC_LLM_DAILY_BUDGET_USD=5

# 纸面账户（仓位计算）
EPIC_ACCOUNT_EQUITY=1000000
EPIC_RISK_PER_TRADE_PCT=0.25
# true = 信号/计划只分析“重点关注”自选；false（默认）= 全市场分析
EPIC_WATCHLIST_ONLY=false

# 告警通知（可选，逗号分隔：serverchan,wechat,email）
EPIC_NOTIFY_CHANNELS=
SERVERCHAN_SENDKEY=
WECHAT_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
SMTP_FROM=

# 数据源（可选代理）
# EPIC_PROXY_URL=
