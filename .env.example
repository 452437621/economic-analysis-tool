# EPIC 环境变量（复制为 .env 后填写；.env 不进版本库）
# 服务
EPIC_HOST=127.0.0.1
EPIC_PORT=8765
EPIC_ENV=local
# 数据库（留空则使用 data/epic.db）
# EPIC_DATABASE_URL=sqlite:///D:/Code/4_个人研发/economic-analysis-tool/data/epic.db
# 数据目录（留空则使用项目 data/）
# EPIC_DATA_DIR=

# LLM
DEEPSEEK_API_KEY=
EPIC_LLM_MODEL=deepseek-chat
EPIC_LLM_REASONER_MODEL=deepseek-reasoner
EPIC_LLM_DAILY_BUDGET_USD=5

# 数据源（M1 起使用）
# EPIC_PROXY_URL=
