{
  "name": "epic-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "EPIC 前端（Vue 3 + TypeScript + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.3",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.469.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.3.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
